// Plataforma FTN — Schema Prisma inicial (Sesión 0)
// Tiempos SIEMPRE en milisegundos enteros (Int). Nunca strings, nunca floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Gender {
  M
  F
}

enum PoolLength {
  P25
  P50
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CLUB_DELEGATE
  COACH
  JUDGE
  SWIMMER
}

enum ClubStatus {
  afiliado
  suspendido
  baja
}

enum TournamentStatus {
  programado
  en_curso
  finalizado
  homologado
}

enum TournamentType {
  provincial
  nacional
  promocional
}

enum ResultStatus {
  OK
  DSQ
  DNS
  DNF
}

enum RecordScope {
  provincial
  nacional
}

enum NewsStatus {
  borrador
  publicada
}

// ─── Identidad y acceso ────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  role       UserRole @default(SWIMMER)
  isActive   Boolean  @default(true) @map("is_active")
  swimmerId  String?  @unique @map("swimmer_id")
  clubId     String?  @map("club_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  lastLogin  DateTime? @map("last_login")

  swimmer    Swimmer? @relation(fields: [swimmerId], references: [id])
  club       Club?    @relation(fields: [clubId], references: [id])
  auditLogs  AuditLog[]
  news       News[]

  @@map("users")
}

// ─── Organización deportiva ────────────────────────────────────────────────

model Club {
  id           String     @id @default(cuid())
  name         String
  shortName    String     @map("short_name")
  locality     String
  logoUrl      String?    @map("logo_url")
  foundedYear  Int?       @map("founded_year")
  contactEmail String?    @map("contact_email")
  status       ClubStatus @default(afiliado)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  users        User[]
  swimmers     Swimmer[]
  affiliations Affiliation[]
  clubHistory  SwimmerClubHistory[]
  tournaments  Tournament[]

  @@map("clubs")
}

model Season {
  id          String   @id @default(cuid())
  year        Int      @unique
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  affiliations Affiliation[]
  tournaments  Tournament[]
  clubHistory  SwimmerClubHistory[]

  @@map("seasons")
}

model Affiliation {
  id        String   @id @default(cuid())
  clubId    String   @map("club_id")
  seasonId  String   @map("season_id")
  status    String   @default("vigente")
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")

  club      Club     @relation(fields: [clubId], references: [id])
  season    Season   @relation(fields: [seasonId], references: [id])

  @@unique([clubId, seasonId])
  @@map("affiliations")
}

model Category {
  id         String  @id @default(cuid())
  name       String  @unique
  code       String  @unique
  minAge     Int     @map("min_age")
  maxAge     Int?    @map("max_age")
  gender     Gender?
  isNational Boolean @default(false) @map("is_national")
  sortOrder  Int     @default(0) @map("sort_order")

  events   Event[]
  records  Record[]

  @@map("categories")
}

model Swimmer {
  id            String   @id @default(cuid())
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  documentId    String   @unique @map("document_id")
  birthDate     DateTime @map("birth_date")
  gender        Gender
  nationality   String   @default("ARG")
  currentClubId String?  @map("current_club_id")
  photoUrl      String?  @map("photo_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  currentClub   Club?                @relation(fields: [currentClubId], references: [id])
  user          User?
  clubHistory   SwimmerClubHistory[]
  registrations Registration[]
  results       Result[]
  personalBests PersonalBest[]
  records       Record[]

  @@map("swimmers")
}

model SwimmerClubHistory {
  id        String   @id @default(cuid())
  swimmerId String   @map("swimmer_id")
  clubId    String   @map("club_id")
  seasonId  String   @map("season_id")
  startDate DateTime @map("start_date")
  endDate   DateTime? @map("end_date")

  swimmer   Swimmer  @relation(fields: [swimmerId], references: [id])
  club      Club     @relation(fields: [clubId], references: [id])
  season    Season   @relation(fields: [seasonId], references: [id])

  @@unique([swimmerId, seasonId])
  @@map("swimmer_club_history")
}

// ─── Competencia ──────────────────────────────────────────────────────────

model EventDefinition {
  id       String @id @default(cuid())
  stroke   String
  distance Int
  gender   Gender
  code     String @unique

  events  Event[]
  records Record[]

  @@map("event_definitions")
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  hostClubId  String?          @map("host_club_id")
  venue       String?
  poolLength  PoolLength       @map("pool_length")
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  type        TournamentType
  status      TournamentStatus @default(programado)
  seasonId    String           @map("season_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  hostClub    Club?    @relation(fields: [hostClubId], references: [id])
  season      Season   @relation(fields: [seasonId], references: [id])
  events      Event[]

  @@map("tournaments")
}

model Event {
  id                String  @id @default(cuid())
  tournamentId      String  @map("tournament_id")
  eventDefinitionId String  @map("event_definition_id")
  categoryId        String  @map("category_id")
  round             String  @default("clasif")
  orderNo           Int     @map("order_no")
  status            String  @default("pendiente")

  tournament        Tournament      @relation(fields: [tournamentId], references: [id])
  eventDefinition   EventDefinition @relation(fields: [eventDefinitionId], references: [id])
  category          Category        @relation(fields: [categoryId], references: [id])
  heats             Heat[]
  registrations     Registration[]
  results           Result[]

  @@map("events")
}

model Heat {
  id          String @id @default(cuid())
  eventId     String @map("event_id")
  heatNumber  Int    @map("heat_number")
  scheduledAt DateTime? @map("scheduled_at")

  event           Event            @relation(fields: [eventId], references: [id])
  laneAssignments LaneAssignment[]
  results         Result[]

  @@unique([eventId, heatNumber])
  @@map("heats")
}

model Registration {
  id          String  @id @default(cuid())
  eventId     String  @map("event_id")
  swimmerId   String  @map("swimmer_id")
  clubId      String  @map("club_id")
  entryTime   Int?    @map("entry_time")
  status      String  @default("pendiente")
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event   @relation(fields: [eventId], references: [id])
  swimmer     Swimmer @relation(fields: [swimmerId], references: [id])
  laneAssignments LaneAssignment[]

  @@unique([eventId, swimmerId])
  @@map("registrations")
}

model LaneAssignment {
  id             String @id @default(cuid())
  heatId         String @map("heat_id")
  registrationId String @map("registration_id")
  lane           Int

  heat           Heat         @relation(fields: [heatId], references: [id])
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@unique([heatId, lane])
  @@map("lane_assignments")
}

model Result {
  id          String       @id @default(cuid())
  eventId     String       @map("event_id")
  swimmerId   String       @map("swimmer_id")
  heatId      String?      @map("heat_id")
  lane        Int?
  finalTime   Int?         @map("final_time")
  place       Int?
  status      ResultStatus @default(OK)
  points      Int?
  isRecord    Boolean      @default(false) @map("is_record")
  homologated Boolean      @default(false)
  categoryId  String       @map("category_id")
  clubId      String       @map("club_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  event       Event    @relation(fields: [eventId], references: [id])
  swimmer     Swimmer  @relation(fields: [swimmerId], references: [id])
  heat        Heat?    @relation(fields: [heatId], references: [id])
  splits      Split[]
  record      Record?

  @@map("results")
}

model Split {
  id        String @id @default(cuid())
  resultId  String @map("result_id")
  distance  Int
  splitTime Int    @map("split_time")

  result    Result @relation(fields: [resultId], references: [id])

  @@unique([resultId, distance])
  @@map("splits")
}

// ─── Marcas, récords y rankings ───────────────────────────────────────────

model PersonalBest {
  id                String     @id @default(cuid())
  swimmerId         String     @map("swimmer_id")
  eventDefinitionId String     @map("event_definition_id")
  poolLength        PoolLength @map("pool_length")
  bestTime          Int        @map("best_time")
  achievedAt        DateTime   @map("achieved_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  swimmer           Swimmer @relation(fields: [swimmerId], references: [id])

  @@unique([swimmerId, eventDefinitionId, poolLength])
  @@map("personal_bests")
}

model Record {
  id                String     @id @default(cuid())
  scope             RecordScope
  eventDefinitionId String     @map("event_definition_id")
  categoryId        String     @map("category_id")
  gender            Gender
  poolLength        PoolLength @map("pool_length")
  time              Int
  swimmerId         String     @map("swimmer_id")
  clubId            String     @map("club_id")
  recordDate        DateTime   @map("record_date")
  sourceResultId    String?    @unique @map("source_result_id")
  isCurrent         Boolean    @default(true) @map("is_current")
  previousRecordId  String?    @map("previous_record_id")
  createdAt         DateTime   @default(now()) @map("created_at")

  eventDefinition   EventDefinition @relation(fields: [eventDefinitionId], references: [id])
  category          Category        @relation(fields: [categoryId], references: [id])
  swimmer           Swimmer         @relation(fields: [swimmerId], references: [id])
  sourceResult      Result?         @relation(fields: [sourceResultId], references: [id])

  @@unique([scope, eventDefinitionId, categoryId, gender, poolLength, isCurrent])
  @@map("records")
}

// ─── Contenido ────────────────────────────────────────────────────────────

model News {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  body        String
  coverUrl    String?    @map("cover_url")
  category    String?
  authorId    String     @map("author_id")
  status      NewsStatus @default(borrador)
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author      User       @relation(fields: [authorId], references: [id])

  @@map("news")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
