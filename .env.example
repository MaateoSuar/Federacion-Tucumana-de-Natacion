# ─── Base de datos ───────────────────────────────────────────────
DATABASE_URL="postgresql://ftn:ftn_password@localhost:5432/ftn_db"

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET="changeme_jwt_secret_min_32_chars"
JWT_REFRESH_SECRET="changeme_jwt_refresh_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Almacenamiento S3-compatible ────────────────────────────────
S3_BUCKET="ftn-files"
S3_REGION="us-east-1"
S3_ACCESS_KEY="changeme_access_key"
S3_SECRET_KEY="changeme_secret_key"
S3_ENDPOINT=""  # dejar vacío para AWS S3; setear para Cloudflare R2 / Supabase

# ─── API (NestJS) ────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ─── Frontend (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
